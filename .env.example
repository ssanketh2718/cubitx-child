
# Copy this file to .env.local for local development.
# Replace the placeholders with your own Supabase project values.
# Never commit .env.local or private service-role/API keys.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Keep unconfigured until a real server-side OTP provider is implemented.
# "mock" is usable only in a Vite development build.
VITE_OTP_PROVIDER=unconfigured
